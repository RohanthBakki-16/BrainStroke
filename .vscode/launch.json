{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: run.py (Auto Open Browser)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Django: Run Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/brainstrokediagnosis/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "justMyCode": true
    }
  ]
}
